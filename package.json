{
  "name": "instinct323.github.io",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.14",
  "overrides": {},
  "scripts": {
    "dev": "bun scripts/build-blog-data.js && bun scripts/copy-content-assets.js && astro dev --host",
    "check": "bun run typecheck && bun run lint && bun run build",
    "build": "bun scripts/build-blog-data.js && bun scripts/copy-content-assets.js && astro build --silent",
    "preview": "astro preview --host",
    "typecheck": "astro check --silent",
    "lint": "bun tests/verify-no-media-json-refs.js && bun tests/verify-no-unused-tokens.js && eslint . --ext .js,.ts,.astro",
    "test:site": "node tests/assert-site-output.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@mdit/plugin-katex": "^0.25.2",
    "astro": "7.1.6",
    "gray-matter": "^4.0.3",
    "jsonc-parser": "^3.3.1",
    "katex": "^0.17.0",
    "markdown-it": "^14.2.0",
    "swiper": "^12.2.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@astrojs/check": "0.9.10",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.8"
  }
}
