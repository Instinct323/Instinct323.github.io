---
import type { ProfileLink } from '../../types/profile';
import { LINK_ICONS } from './link-icons';
import '../../styles/pills.css';

interface Props {
  links?: ProfileLink[];
}

const { links } = Astro.props;

const validLinks = (links ?? []).filter((link) => link.value && link.value.trim());
---

{validLinks.length > 0 && (
  <section data-testid="about-links" class="links-section">
    <div class="links-scroll">
      {validLinks.map((link) => {
        const icon = LINK_ICONS[link.key] || LINK_ICONS.fallback;
        // Sentinel value: profile links without a defined URL use '#' so we render a non-clickable pill instead of an anchor.
        if (link.value === '#') {
          return (
            <span class="pill link-pill" data-nonclick>
              <span class="pill-icon" set:html={icon} />
              <span class="pill-label">{link.key}</span>
            </span>
          );
        }
        return (
          <a class="pill link-pill" href={link.value} target="_blank" rel="noopener noreferrer">
            <span class="pill-icon" set:html={icon} />
            <span class="pill-label">{link.key}</span>
          </a>
        );
      })}
    </div>
  </section>
)}

<style>
  .links-scroll {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    flex-wrap: nowrap;
    -webkit-overflow-scrolling: touch;
  }
  .link-pill {
    gap: 0.375rem;
    white-space: nowrap;
  }
  .pill-icon {
    display: inline-flex;
    width: 16px;
    height: 16px;
    color: var(--text-muted);
  }
  .pill-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .pill-label {
    line-height: 1;
  }
  [data-nonclick] {
    cursor: default;
    opacity: 0.85;
  }

  @media (max-width: 767px) {
    .links-scroll {
      scrollbar-width: none;
    }
    .links-scroll::-webkit-scrollbar {
      display: none;
    }
  }
</style>
