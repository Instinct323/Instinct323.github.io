---
import Layout from '~/features/layout/Layout.astro';
import '~/features/blog/loader';
import { renderMarkdownWithKatex } from '~/core/content/markdown';
import { orchestratePageLoad } from '~/features/site/load';
import { getPageLoader } from '~/features/site/load';
import { LATEX_REGEX, type BlogPageFrame } from '~/core/content/blog-data-types';

const blogLoad = await orchestratePageLoad({
  frame: getPageLoader('blog').frame,
});

const { posts } = blogLoad.frame as BlogPageFrame;
const initialPost = posts[0];
const initialContentHtml = renderMarkdownWithKatex(initialPost.content, { fileURL: initialPost.baseUrl });
const needsKatex = posts.some((post) => LATEX_REGEX.test(post.content));
---

<Layout
  contentWidth="wide"
  needsKatex={needsKatex}
>
  <section class="blog-page page-container layout-content-container">
    <div class="blog-container">
      <aside class="blog-list" id="blog-list">
        {posts.map((post, index) => (
          <button
            class:list={['card', 'blog-item', { active: index === 0 }]}
            data-slug={post.slug}
          >
            <h3 class="blog-item-title">
              <span class="title-fade">{post.title}</span>
              {post.weight > 0 && <span class="blog-item-pin">Pinned</span>}
            </h3>
            {post.date && (
              <div class="blog-item-date">
                <span class="date-mask" />
                <time datetime={post.date.toISOString()}>
                  {post.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              </div>
            )}
          </button>
        ))}
      </aside>

      <div class="blog-detail">
        <article class="card" id="blog-detail-card">
          <h1 id="detail-title" class="title-fade">{initialPost.title}</h1>
          <div id="detail-content" set:html={initialContentHtml} />
        </article>
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog-container {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .blog-page :global(.card) {
    width: 100%;
    box-sizing: border-box;
  }

  .blog-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-sm);
    position: sticky;
    min-width: 0;
    top: calc(var(--header-height) + var(--space-stack-sm));
  }

  .blog-item {
    cursor: pointer;
    min-height: 44px;
    padding: 0.75rem;
    text-align: left;
    transition: background var(--motion-duration-sm) var(--motion-ease-smooth);
  }

  .blog-item:hover {
    background: var(--shell-elevated-card-bg);
  }

  .blog-item:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }

  .blog-item.active {
    background: var(--shell-elevated-card-bg);
    border-color: rgba(59, 130, 246, 0.4);
  }

  .title-fade {
    white-space: nowrap;
    overflow: hidden;
    flex: 1;
    min-width: 0;
    mask-image: linear-gradient(to right, black 85%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%);
  }

  .blog-item-title {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0 0 0.5rem 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-strong);
    line-height: 1.4;
  }

  .blog-item-pin {
    display: inline-block;
    font-size: var(--font-size-xs);
    background: var(--link-accent);
    color: white;
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-sm);
    vertical-align: middle;
    font-weight: 500;
    flex-shrink: 0;
  }

  .blog-item-date {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--font-size-xs);
    color: var(--text-muted);
  }

  .date-mask {
    width: 2px;
    height: 12px;
    background: var(--surface-border);
    border-radius: 1px;
  }

  .blog-detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-md);
    min-width: 0;
  }

  #detail-title {
    margin: 0 0 var(--space-stack-md) 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-strong);
  }

  #detail-content {
    font-size: 1rem;
    color: var(--text-body);
    line-height: 1.6;
  }

  #detail-content :global(h2) {
    margin: 1.5rem 0 0.75rem 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-strong);
  }

  #detail-content :global(h3) {
    margin: 1.25rem 0 0.5rem 0;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-strong);
  }

  #detail-content :global(p) {
    margin: 0.75rem 0;
  }

  #detail-content :global(pre) {
    background: var(--shell-elevated-surface-bg);
    padding: 1rem;
    border-radius: var(--radius-sm);
    overflow-x: auto;
  }

  #detail-content :global(code) {
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 0.875rem;
  }

  #detail-content :global(blockquote) {
    margin: 1rem 0;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--link-accent);
    background: var(--shell-elevated-surface-bg);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  #detail-content :global(blockquote p) {
    margin: 0;
    color: var(--text-body);
  }

  @media (max-width: 767px) {
    .blog-container {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .blog-list {
      position: static;
      align-items: stretch;
    }
  }


</style>

<script is:inline define:vars={{ postMeta: posts.map((p) => ({ slug: p.slug, title: p.title })) }}>
  window.__BLOG_META__ = postMeta;
</script>

<script>
  import { renderMarkdown } from '~/core/content/markdown-client';
  import type { BlogPostData } from '~/core/content/blog-data-types';

  (() => {
    const blogList = document.getElementById('blog-list');
    const detailTitle = document.getElementById('detail-title');
    const detailContent = document.getElementById('detail-content');

    if (!blogList || !detailTitle || !detailContent) return;

    const postsMeta = window.__BLOG_META__;
    const metaBySlug = new Map(postsMeta.map((m) => [m.slug, m]));
    const postCache = new Map<string, BlogPostData>();

    async function loadPost(slug: string): Promise<BlogPostData | null> {
      const cached = postCache.get(slug);
      if (cached) return cached;

      try {
        const res = await fetch(`/blog-data/${slug}.json`);
        if (!res.ok) return null;
        const data = (await res.json()) as BlogPostData;
        postCache.set(slug, data);
        return data;
      } catch {
        return null;
      }
    }

    function prefetchPost(slug: string): void {
      fetch(`/blog-data/${slug}.json`, { priority: 'low' } as RequestInit).catch(() => {
        // prefetch failures are non-critical
      });
    }

    async function renderPostContent(content: string, baseUrl: string, hasLatex: boolean): Promise<string> {
      if (hasLatex) {
        try {
          const { renderMarkdownWithKatex } = await import('~/core/content/markdown-katex');
          return renderMarkdownWithKatex(content, { fileURL: baseUrl });
        } catch (e) {
          console.error('Failed to load katex renderer:', e);
          setStatusMessage('Failed to load article.', '#ef4444');
          return '';
        }
      }
      return renderMarkdown(content, { fileURL: baseUrl });
    }

    function setStatusMessage(text: string, color: string): void {
      if (!detailContent) return;
      detailContent.innerHTML = '';
      const el = document.createElement('div');
      el.textContent = text;
      el.style.cssText = `color: ${color}; padding: 2rem 0; text-align: center;`;
      detailContent.appendChild(el);
    }

    const items = blogList.querySelectorAll('.blog-item');

    items.forEach((item) => {
      const slug = (item as HTMLElement).dataset.slug;
      if (!slug) return;

      item.addEventListener('mouseenter', () => prefetchPost(slug), { once: true });

      item.addEventListener('click', async () => {
        items.forEach((i) => i.classList.remove('active'));
        item.classList.add('active');

        const meta = metaBySlug.get(slug);
        if (!meta) return;

        detailTitle.textContent = meta.title;
        setStatusMessage('Loading...', 'var(--text-muted)');

        const post = await loadPost(slug);
        if (!post) {
          setStatusMessage('Failed to load article.', '#ef4444');
          return;
        }

        detailTitle.textContent = post.title;
        detailContent.innerHTML = await renderPostContent(post.content, post.baseUrl, post.hasLatex);
      });
    });
  })();
</script>