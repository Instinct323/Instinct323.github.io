---
import Layout from '~/features/layout/Layout.astro';
import '~/features/blog/loader';
import { renderMarkdownWithKatex } from '~/core/content/markdown';
import { orchestratePageLoad, getPageLoader } from '~/features/site/load';
import { LATEX_REGEX, type BlogPageFrame } from '~/core/content/blog-data-types';

const blogLoad = await orchestratePageLoad({
  frame: getPageLoader('blog').frame,
});

const { posts } = blogLoad.frame as BlogPageFrame;
const initialPost = posts[0];
const initialContentHtml = renderMarkdownWithKatex(initialPost.content, { fileURL: initialPost.baseUrl });
const needsKatex = LATEX_REGEX.test(initialPost.content);
---

<Layout
  contentWidth="wide"
  needsKatex={needsKatex}
>
  <section class="blog-page page-container layout-content-container">
    <div class="blog-container">
      <aside class="blog-list" id="blog-list">
        {posts.map((post, index) => (
          <button
            class:list={['card', 'blog-item', { active: index === 0 }]}
            data-slug={post.slug}
          >
            <h3 class="blog-item-title">
              <span class="title-fade">{post.title}</span>
              {post.weight > 0 && <span class="blog-item-pin">Pinned</span>}
            </h3>
            {post.date && (
              <div class="blog-item-date">
                <span class="date-mask" />
                <time datetime={post.date.toISOString()}>
                  {post.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              </div>
            )}
          </button>
        ))}
      </aside>

      <div class="blog-detail">
        <article class="card" id="blog-detail-card">
          <h1 id="detail-title" class="title-fade">{initialPost.title}</h1>
          <div id="detail-content" set:html={initialContentHtml} />
        </article>
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog-container {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .blog-page :global(.card) {
    width: 100%;
    box-sizing: border-box;
  }

  .blog-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-sm);
    position: sticky;
    min-width: 0;
    top: calc(var(--header-height) + var(--space-stack-sm));
  }

  .blog-item {
    cursor: pointer;
    min-height: 44px;
    padding: 0.75rem;
    text-align: left;
    transition: background var(--motion-duration-sm) var(--motion-ease-smooth);
  }

  .blog-item:hover {
    background: var(--shell-elevated-card-bg);
  }

  .blog-item:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }

  .blog-item.active {
    background: var(--shell-elevated-card-bg);
    border-color: rgba(59, 130, 246, 0.4);
  }

  .title-fade {
    white-space: nowrap;
    overflow: hidden;
    flex: 1;
    min-width: 0;
    mask-image: linear-gradient(to right, black 85%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%);
  }

  .blog-item-title {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0 0 0.5rem 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-strong);
    line-height: 1.4;
  }

  .blog-item-pin {
    display: inline-block;
    font-size: var(--font-size-xs);
    background: var(--link-accent);
    color: white;
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-sm);
    vertical-align: middle;
    font-weight: 500;
    flex-shrink: 0;
  }

  .blog-item-date {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--font-size-xs);
    color: var(--text-muted);
  }

  .date-mask {
    width: 2px;
    height: 12px;
    background: var(--surface-border);
    border-radius: 1px;
  }

  .blog-detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-md);
    min-width: 0;
  }

  #detail-title {
    margin: 0 0 var(--space-stack-md) 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-strong);
  }

  #detail-content {
    font-size: 1rem;
    color: var(--text-body);
    line-height: 1.6;
  }

  #detail-content :global(h2) {
    margin: 1.5rem 0 0.75rem 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-strong);
  }

  #detail-content :global(h3) {
    margin: 1.25rem 0 0.5rem 0;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-strong);
  }

  #detail-content :global(p) {
    margin: 0.75rem 0;
  }

  #detail-content :global(pre) {
    background: var(--shell-elevated-surface-bg);
    padding: 1rem;
    border-radius: var(--radius-sm);
    overflow-x: auto;
  }

  #detail-content :global(code) {
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 0.875rem;
  }

  #detail-content :global(blockquote) {
    margin: 1rem 0;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--link-accent);
    background: var(--shell-elevated-surface-bg);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  #detail-content :global(blockquote p) {
    margin: 0;
    color: var(--text-body);
  }

  @media (max-width: 767px) {
    .blog-container {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .blog-list {
      position: static;
      align-items: stretch;
    }
  }

  :global(.blog-status) {
    padding: 2rem 0;
    text-align: center;
  }
  :global(.blog-status--loading) {
    color: var(--text-muted);
  }
  :global(.blog-status--error) {
    color: #ef4444;
  }


</style>

<script is:inline define:vars={{ postMeta: posts.map((p) => ({ slug: p.slug, title: p.title })) }}>
  window.__BLOG_META__ = postMeta;
  (() => {
    const hash = location.hash.slice(1);
    if (!hash) return;
    document.querySelectorAll('.blog-item').forEach((el) => {
      el.classList.toggle('active', el.dataset.slug === hash);
    });
    const meta = postMeta.find((m) => m.slug === hash);
    const defaultSlug = postMeta[0]?.slug;
    if (meta && meta.slug !== defaultSlug) {
      const detailTitle = document.getElementById('detail-title');
      const detailContent = document.getElementById('detail-content');
      if (detailTitle) detailTitle.textContent = meta.title;
      if (detailContent) detailContent.innerHTML = '<div class="blog-status blog-status--loading">Loading...</div>';
    }
  })();
</script>

<script>
  import { initBlogClient } from '~/features/blog/client';
  initBlogClient();
</script>