---
import Layout from '../layouts/Layout.astro';
import AvatarSection from '../components/about/AvatarSection.astro';
import ContentSection from '../components/about/ContentSection.astro';
import LinksSection from '../components/about/LinksSection.astro';
import ProfileCard from '../components/about/ProfileCard.astro';
import PublicationsSection from '../components/about/PublicationsSection.astro';
import '../lib/loaders/content-loader';
import { loadMediaConfig } from '../lib/loaders/config-loader';
import { orchestratePageLoad } from '../lib/loaders/page-load-orchestrator';
import { getPageLoader } from '../lib/loaders/page-loader-registry';
import type { AboutPageData, MediaConfig } from '../types/site';
import type { ContentImage } from '../types/media';

const aboutLoader = getPageLoader('about');
const aboutLoad = await orchestratePageLoad({
  frame: async () => {
    const [aboutFrame, mediaConfig] = await Promise.all([
      aboutLoader.frame() as Promise<Omit<AboutPageData, 'avatarImage'>>,
      loadMediaConfig(),
    ]);

    return {
      ...aboutFrame,
      mediaConfig,
    };
  },
  controls: aboutLoader.controls,
});

const { introductionHtml, profile, publications } = aboutLoad.frame as Omit<AboutPageData, 'avatarImage'> & { mediaConfig: MediaConfig };
const avatarImage = aboutLoad.controls as ContentImage;
const profileName = profile.name;
---

<Layout
  shell="about"
  contentWidth="wide"
>
  <section
    class="about-page page-container layout-content-container"
  >
    <div class="about-container">
      <aside class="left-rail">
        <AvatarSection
          avatarImage={avatarImage}
        />
        <ProfileCard facts={profile.facts} />
      </aside>

      <div class="about-content">
        <LinksSection links={profile.links} />
        <ContentSection introductionHtml={introductionHtml} />
        <PublicationsSection publications={publications} highlightAuthor={profileName} />
      </div>
    </div>
  </section>
</Layout>

<script>
  import { initDeferredMounts } from '../lib/deferred-mount-page';

  if (import.meta.env.SSR === false) {
    initDeferredMounts();
  }
</script>

<style>
  .about-container {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .about-page :global(.card) {
    width: 100%;
    box-sizing: border-box;
  }

  .left-rail {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-md);
    position: sticky;
    min-width: 0;
    /* Keep a visible gap so the sticky rail does not visually collide with the header. */
    top: calc(var(--header-height) + var(--space-stack-sm));
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-md);
    min-width: 0; /* Prevent overflow */
  }

  @media (max-width: 767px) {
    .about-container {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .left-rail {
      position: static;
      align-items: stretch;
    }
  }
</style>
