---
import Layout from '~/features/layout/Layout.astro';
import AvatarSection from '~/features/about/profile/Avatar.astro';
import ContentSection from '~/features/about/Content.astro';
import LinksSection from '~/features/about/Links.astro';
import ProfileCard from '~/features/about/profile/Card.astro';
import PublicationsSection from '~/features/about/publication/List.astro';
import { orchestratePageLoad, getPageLoader } from '~/features/site/load';

const aboutLoader = getPageLoader('about');

const aboutLoad = await orchestratePageLoad({
  frame: aboutLoader.frame,
  controls: aboutLoader.controls,
});

const { introductionHtml, profile, publications } = aboutLoad.frame;
const avatarImage = aboutLoad.controls;
if (!avatarImage) {
  throw new Error('About page controls unexpectedly returned null');
}
const profileName = profile.name;
---

<Layout
  shell="about"
  contentWidth="wide"
>
  <section
    class="about-page page-container layout-content-container"
  >
    <div class="about-container">
      <aside class="left-rail">
        <AvatarSection
          avatarImage={avatarImage}
        />
        <ProfileCard facts={profile.facts} />
      </aside>

      <div class="about-content">
        <LinksSection links={profile.links} />
        <ContentSection introductionHtml={introductionHtml} />
        <PublicationsSection publications={publications} highlightAuthor={profileName} />
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-container {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .about-page :global(.card) {
    width: 100%;
    box-sizing: border-box;
  }

  .left-rail {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-md);
    position: sticky;
    min-width: 0;
    /* Keep a visible gap so the sticky rail does not visually collide with the header. */
    top: calc(var(--header-height) + var(--space-stack-sm));
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack-md);
    min-width: 0; /* Prevent overflow */
  }

  @media (max-width: 767px) {
    .about-container {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .left-rail {
      position: static;
      align-items: stretch;
    }
  }
</style>
