---
import {
  DEFERRED_MOUNT_STATE,
} from '~/core/runtime/deferred-mount';
import { assertBoolean, assertString } from '~/core/validation/assert';

interface Props {
  enabled?: boolean;
  group?: string;
  placeholderText?: string;
  announcePlaceholder?: boolean;
}

const {
  enabled: rawEnabled = true,
  group: rawGroup,
  placeholderText: rawPlaceholderText,
  announcePlaceholder: rawAnnouncePlaceholder = false,
} = Astro.props;

const enabled = assertBoolean(rawEnabled, 'DeferredMount.enabled');
const announcePlaceholder = assertBoolean(rawAnnouncePlaceholder, 'DeferredMount.announcePlaceholder');
const group = rawGroup === undefined ? undefined : assertString(rawGroup, 'DeferredMount.group');
const placeholderText = rawPlaceholderText === undefined ? undefined : assertString(rawPlaceholderText, 'DeferredMount.placeholderText');
---

<div
  class="deferred-mount"
  data-deferred-mount={enabled ? 'true' : 'false'}
  data-deferred-state={enabled ? 'pending' : DEFERRED_MOUNT_STATE.loaded}
  data-deferred-group={group}
  aria-busy={enabled ? 'true' : 'false'}
>
  {enabled ? (
    <>
      <div
        class="deferred-placeholder"
        data-deferred-placeholder
        data-deferred-placeholder-state="loading"
        role={announcePlaceholder ? 'status' : undefined}
        aria-live={announcePlaceholder ? 'polite' : undefined}
      >
        <slot name="placeholder">
          <span class="deferred-placeholder-text" data-deferred-placeholder-text>{placeholderText !== undefined ? placeholderText : 'Loading…'}</span>
        </slot>
      </div>
      <div data-deferred-host></div>
      <template data-deferred-template>
        <slot />
      </template>
      <noscript>
        <slot />
      </noscript>
    </>
  ) : (
    <slot />
  )}
</div>

<style>
  .deferred-mount {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .deferred-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 250ms ease;
  }

  .deferred-placeholder-text {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  [data-deferred-host] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .deferred-mount[data-deferred-state="loaded"] .deferred-placeholder {
    opacity: 0;
    pointer-events: none;
  }
</style>
