---
/* eslint-disable astro/jsx-a11y/media-has-caption -- Music-only audio has no spoken captions; button text exposes playback status. */
import type { MusicConfig } from '~/core/config/music';

interface Props {
  music: MusicConfig;
}

const { music } = Astro.props;
---

<div class="record-control" data-record-control data-testid="record-control">
  <audio data-record-audio data-testid="record-control-audio" preload="metadata" aria-label="Music track">
    <source src={music.publicPath} type={music.mimeType} />
  </audio>
  <button
    class="record-button"
    data-record-button
    data-testid="record-control-button"
    type="button"
    aria-pressed="false"
    aria-label="Play music"
  >
    <span class="turntable-deck" aria-hidden="true">
      <span class="record-disc">
        <span class="record-label"></span>
      </span>
      <span class="tonearm-base">
        <span class="tonearm-beam"></span>
      </span>
    </span>
    <span class="record-status" data-record-status aria-live="polite">
      Music paused
    </span>
  </button>
</div>

<style>
  .record-control {
    position: fixed;
    right: var(--space-page-x);
    bottom: var(--space-stack-md);
    z-index: 40;
    max-width: calc(100vw - var(--space-page-x) * 2);
  }

  .record-button {
    display: inline-grid;
    min-width: 4.75rem;
    min-height: 3.375rem;
    place-items: center;
    box-sizing: border-box;
    max-width: 100%;
    padding: 0;
    border: 0;
    border-radius: 0.875rem;
    background: transparent;
    cursor: pointer;
    transition: transform var(--motion-duration-ui) var(--motion-ease-standard);
  }

  .record-button:hover:not(:disabled) {
    transform: var(--motion-lift-sm);
  }

  .record-button:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    transform: var(--motion-lift-sm);
  }

  .record-button:disabled {
    cursor: not-allowed;
  }

  .turntable-deck {
    position: relative;
    width: 4.75rem;
    height: 3.375rem;
    flex: 0 0 auto;
    overflow: hidden;
    border: 1px solid var(--shell-elevated-surface-border);
    border-radius: 0.875rem;
    background:
      radial-gradient(circle at 72% 22%, rgba(43, 81, 182, 0.18), transparent 0.75rem),
      linear-gradient(145deg, rgba(255, 255, 255, 0.68), var(--shell-elevated-canvas));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.75),
      inset 0 -0.75rem 1.25rem rgba(16, 42, 67, 0.08);
  }

  .record-disc {
    position: absolute;
    left: 0.65625rem;
    top: 0.59375rem;
    width: 2.1875rem;
    height: 2.1875rem;
    border-radius: var(--pill-radius);
    background:
      radial-gradient(circle at 67% 28%, rgba(255, 255, 255, 0.36) 0 0.125rem, transparent 0.15625rem),
      repeating-radial-gradient(
        circle at center,
        rgba(248, 250, 252, 0.18) 0 0.03125rem,
        transparent 0.03125rem 0.1875rem
      ),
      radial-gradient(circle at center, #182436 0, #102a43 62%, #07101f 100%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.18),
      0 0.375rem 0.75rem rgba(16, 42, 67, 0.16);
    animation: record-spin 14s linear 260ms infinite;
    animation-play-state: var(--record-spin-state, paused);
  }

  .record-disc::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 0.1875rem;
    width: 0.1875rem;
    height: 0.1875rem;
    border-radius: var(--pill-radius);
    background: rgba(255, 255, 255, 0.78);
    transform: translateX(-50%);
  }

  .record-label {
    position: absolute;
    inset: 0.71875rem;
    border-radius: var(--pill-radius);
    background:
      radial-gradient(circle at center, var(--shell-elevated-card-bg) 0 0.125rem, transparent 0.15625rem),
      radial-gradient(circle at 38% 32%, rgba(255, 255, 255, 0.85), transparent 0.3125rem),
      var(--link-accent);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.34),
      0 0 0.875rem rgba(43, 81, 182, 0.34);
  }

  .tonearm-base {
    position: absolute;
    right: 0.4375rem;
    top: 0.4375rem;
    width: 0.9375rem;
    height: 0.9375rem;
    border-radius: var(--pill-radius);
    background:
      radial-gradient(circle at center, var(--shell-elevated-card-bg) 0 0.125rem, transparent 0.15625rem),
      var(--shell-elevated-surface-bg);
    box-shadow:
      inset 0 0 0 1px var(--shell-elevated-surface-border),
      0 0 0.625rem rgba(43, 81, 182, 0.12);
  }

  .tonearm-beam {
    position: absolute;
    left: 0.3125rem;
    top: 0.4375rem;
    width: 1.625rem;
    height: 0.1875rem;
    border-radius: var(--pill-radius);
    background: linear-gradient(90deg, #486581, var(--link-accent));
    box-shadow: 0 0.0625rem 0.25rem rgba(16, 42, 67, 0.18);
    transform: rotate(var(--record-arm-angle, 99deg));
    transform-origin: 0.125rem 50%;
    transition: transform var(--motion-duration-md) var(--motion-ease-smooth);
    transition-delay: var(--record-arm-delay, 80ms);
  }

  .tonearm-beam::after {
    content: '';
    position: absolute;
    right: -0.125rem;
    top: -0.0625rem;
    width: 0.375rem;
    height: 0.3125rem;
    border-radius: 0.125rem;
    background: #102a43;
    transform: rotate(16deg);
  }

  .record-status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .record-button:disabled .turntable-deck {
    opacity: 0.72;
  }

  .record-button:disabled .record-disc,
  .record-button:disabled .record-label {
    box-shadow: inset 0 0 0 1px var(--shell-elevated-surface-border);
  }

  @media (prefers-reduced-motion: reduce) {
    .record-disc {
      animation: none;
    }

    .tonearm-beam,
    .record-button {
      transition: none;
    }
  }

  @keyframes record-spin {
    to {
      transform: rotate(1turn);
    }
  }

  @media (max-width: 767px) {
    .record-control {
      bottom: var(--space-stack-sm);
    }

    .record-button {
      min-width: 4.25rem;
      min-height: 3.75rem;
      border-radius: 1rem;
    }

    .turntable-deck {
      width: 4.25rem;
      height: 3rem;
    }

    .record-disc {
      left: 0.59375rem;
      top: 0.53125rem;
      width: 1.9375rem;
      height: 1.9375rem;
    }

    .record-label {
      inset: 0.625rem;
    }

  }
</style>
