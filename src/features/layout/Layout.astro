---
// Layout.astro — page shell orchestrator
// Loading contract: frame (metadata + media + effects) → background (images) → template (SEO + shell + starfield)
import LayoutHead from '~/features/layout/Head.astro';
import Footer from '~/features/layout/Footer.astro';
import Header from '~/features/layout/Header.astro';
import RecordControl from '~/features/layout/RecordControl.astro';
import type { LayoutProps } from '~/features/layout/types';
import { orchestratePageLoad } from '~/features/site/load';
import { loadLayoutBackgrounds } from '~/features/layout/layout-background';
import { loadLayoutFrame, type LayoutFrameData } from '~/features/layout/loader';
import { resolveLayoutSeo } from '~/features/layout/layout-seo';
import { buildLayoutShell } from '~/features/layout/layout-shell';
import type { LayoutBackgroundData } from '~/features/layout/layout-background';
import '~/styles/layout-shell.css';
import '~/styles/tokens.css';

type Props = LayoutProps;

const {
  title,
  description,
  type = 'website',
  noindex = false,
  shell = 'default',
  contentWidth = 'standard',
  needsKatex = false,
} = Astro.props;

const layoutLoad = await orchestratePageLoad<LayoutFrameData, LayoutBackgroundData, never>({
  frame: loadLayoutFrame,
  background: loadLayoutBackgrounds,
});

const {
  siteMetadata,
  musicConfig,
  effectsConfig,
} = layoutLoad.frame;
if (!layoutLoad.background) {
  throw new Error('Layout background data is required but missing');
}
const { backgroundMobile, backgroundDesktop } = layoutLoad.background;

// Fail-fast: Astro.site must be configured in astro.config.ts
if (!Astro.site) {
  throw new Error('Astro.site is not configured. Please set site in astro.config.ts.');
}
const siteUrl = Astro.site;

const {
  resolvedTitle,
  resolvedDescription,
  keyword,
  canonicalUrl,
  sitemapUrl,
} = resolveLayoutSeo({ title, description, siteMetadata, siteUrl, pathname: Astro.url.pathname });

const { shellStyle, shellBackgroundPayload } = buildLayoutShell({
  shell,
  contentWidth,
  backgroundMobile,
  backgroundDesktop,
});

const starfieldConfig = effectsConfig.starfield;
---

<!doctype html>
<html lang="en">
  <head>
    <LayoutHead
      generator={Astro.generator}
      title={resolvedTitle}
      description={resolvedDescription}
      keyword={keyword}
      canonicalUrl={canonicalUrl}
      sitemapUrl={sitemapUrl}
      type={type}
      noindex={noindex}
      needsKatex={needsKatex}
    />
    <style is:inline set:html={`
      :root {
        --page-bg-image-mobile: url('${backgroundMobile.src}');
        --page-bg-image-desktop: url('${backgroundDesktop.src}');
      }
    `} />
  </head>
  <body data-shell={shell} style={shellStyle}>
    <div
      class="site-frame"
      aria-hidden="true"
      data-shell-background={shellBackgroundPayload}
    >
      <canvas class="site-stars-background"></canvas>
      <canvas
        class="site-stars"
        data-testid="site-stars"
        data-starfield={JSON.stringify(starfieldConfig)}
      ></canvas>
    </div>
    <main class="site-shell" data-shell={shell} data-testid="site-shell">
      <Header />
      <slot />
      <Footer />
    </main>
    <RecordControl music={musicConfig} />
    <script>
      import { initLayout } from '~/core/runtime/layout';
      import { initRecordControl } from '~/core/runtime/record-control';

      initLayout();
      initRecordControl();
    </script>
  </body>
</html>
